# .env 파일의 예시 (팀원은 이 파일을 복사해서 .env를 만들 것)
#   cp .env.example .env

# 백엔드(Spring Boot) API 서버 주소
VITE_BACKEND_URL=http://localhost:8080

# AI(FastAPI) 서버 주소
VITE_PYTHON_URL=http://localhost:8000

# 카카오맵 JS SDK 키 (JavaScript 키 — 카카오 개발자 콘솔에서 발급)
# 발급: https://developers.kakao.com/console/app > 내 애플리케이션 > 앱 키 > JavaScript 키
# 카카오 콘솔 "플랫폼 > Web"에 사용하는 도메인(예: http://localhost:5173, 배포 도메인)을
# 반드시 등록해야 그 도메인에서만 동작한다 — 도메인 제한 전제이므로 공개형(브라우저 노출) 키다.
# 그래도 서버에서만 써야 하는 REST API 키/시크릿과는 절대 혼동해 여기 넣지 않는다.
VITE_KAKAO_JS_KEY=
