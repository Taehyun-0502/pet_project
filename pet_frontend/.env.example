# .env 파일의 예시 (팀원은 이 파일을 복사해서 .env를 만들 것)
#   cp .env.example .env

# 백엔드(Spring Boot) API 서버 주소
VITE_BACKEND_URL=http://localhost:8080

# AI(FastAPI) 서버 주소
VITE_PYTHON_URL=http://localhost:8000

# 카카오맵 JS SDK 키 (JavaScript 키 — 카카오 개발자 콘솔에서 발급)
# 발급: https://developers.kakao.com/console/app > 내 애플리케이션 > 앱 키 > JavaScript 키
# 카카오 콘솔 "플랫폼 > Web"에 사용하는 도메인(예: http://localhost:5173, 배포 도메인)을
# 반드시 등록해야 그 도메인에서만 동작한다 — 도메인 제한 전제이므로 공개형(브라우저 노출) 키다.
# 그래도 서버에서만 써야 하는 REST API 키/시크릿과는 절대 혼동해 여기 넣지 않는다.
VITE_KAKAO_JS_KEY=

# 카카오 소셜 로그인용 REST API 키 (인가 URL의 client_id) — 리뷰 백로그 89번으로 추가.
# **위 경고의 예외다**: 이 값은 인가 URL에 그대로 실려 브라우저에 노출되는 것이 정상이고
# (카카오가 Redirect URI 등록으로 사용처를 제한한다), 토큰 교환은 서버가 client-secret으로 한다.
# 지도용 앱과 **다른 앱**의 키다 — 소셜 로그인 앱의 REST API 키를 넣을 것.
# 미설정 시 로그인 화면의 카카오 버튼이 "설정되지 않았습니다" 안내를 띄운다(종전엔 조용히 실패했다).
VITE_KAKAO_CLIENT_ID=
