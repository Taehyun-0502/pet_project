# 이 파일은 커밋 대상입니다. 실제 값은 절대 넣지 말고, 각자 로컬 .env에 채워 넣으세요.
# 사용법: cp .env.example .env  (그리고 .env에 실제 값 입력 — .env는 .gitignore에 등록되어 커밋되지 않습니다)

# Supabase PostgreSQL 연결
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# JWT 서명 시크릿 / 액세스 토큰 만료(ms)
# JWT_SECRET은 **문자열 그 자체가 서명 키**다. 서명은 HS512로 고정돼 있어
# UTF-8 기준 64바이트 이상이어야 하고, 짧으면 기동이 실패한다(조용히 약한 알고리즘으로 내려가지 않게 —
# 리뷰 백로그 6번). 48바이트 난수를 base64로 인코딩하면 64자가 나오므로 그 값을 쓰면 된다:
#   openssl rand -base64 48
# 더 길어도 되지만 **길이보다 무작위성이 중요하다** — 같은 문자를 늘려 64자를 채우는 것은 의미가 없다.
# 값을 바꾸면 이미 발급된 액세스 토큰만 무효가 되고 로그아웃되지는 않는다(리프레시 토큰은 JWT가 아니라
# DB 난수라 키와 무관 — 프론트의 자동 재발급이 새 키로 복구한다). 팀원끼리 값이 달라도 되지만,
# 배포에서 인스턴스를 여러 개 띄우면 반드시 같은 값이어야 한다(A가 발급한 토큰을 B가 검증하지 못한다).
# JWT_EXPIRATION_MS는 액세스 토큰 만료. 현재 합의값은 15분 = 900000 (api-spec.md 1절)
JWT_SECRET=
JWT_EXPIRATION_MS=900000

# Anthropic API (AI 챗봇 함수 호출용)
ANTHROPIC_API_KEY=

# 카카오 로컬 API REST 키 (지도/장소 추천용) — https://developers.kakao.com
# 반드시 "REST API 키"만 넣을 것 — 카카오맵 JavaScript 키를 넣으면 서버(KakaoClient) 호출이
# 401(KA Header is required)로 실패한다. JS 키는 이 파일이 아니라 pet_frontend/.env의
# VITE_KAKAO_JS_KEY 전용이다 (카카오 콘솔 앱 설정 화면에서 REST API 키/JavaScript 키가 서로 다름).
KAKAO_REST_API_KEY=

# 기상청 단기예보 조회서비스 (산책 아스팔트 온도 안내용) — 공공데이터포털(data.go.kr)에서
# "기상청_단기예보 조회서비스" 활용신청 후 발급되는 "일반 인증키(Decoding)"를 넣는다.
# 비어 있어도 기동은 되고, KmaClient가 mock 날씨(고정값)로 폴백한다.
KMA_SERVICE_KEY=

# 산책 브리핑 판정 스케줄러(WalkBriefingScheduler) 실행 시각 — 비워두면 기본값(매일 17:55
# KST) 사용. 테스트 중 바로 확인하고 싶을 때만 원하는 cron 표현식으로 임시 변경.
WALK_BRIEFING_CRON=
# 카카오 OAuth (소셜 로그인 — 지도용과 별개 앱). client-secret은 콘솔에서 활성화한 경우만
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=

# 리프레시 토큰 쿠키의 Secure 속성 — LAN(http://192.168.x.x) 접속 테스트 때만 false로.
# 켜두면(기본 true) LAN에서는 쿠키가 저장되지 않아 15분 뒤 조용히 로그아웃된다. 배포는 반드시 true
#COOKIE_SECURE=false

# 프론트 허용 오리진 (쉼표 구분) — HTTP CORS + WebSocket **공용** 단일 출처.
# 미설정 시 localhost:5173/5174만 허용. LAN·배포 오리진은 코드가 아니라 여기에 —
# 덮어쓰기 방식이므로 localhost를 포함한 전체 목록을 적는다. 예:
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://192.168.0.X:5173

# 프론트 웹 서비스 베이스 URL (MCP 대화형 입구, mcp 패키지 도구가 답변에 붙이는 링크 출처).
# 미설정 시 로컬 프론트 dev 서버(http://localhost:5173). 배포 시에만 실제 도메인으로 채운다.
#WEB_BASE_URL=
