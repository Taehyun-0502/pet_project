# Pet Care 백엔드 systemd 유닛 (EC2: /etc/systemd/system/petcare-backend.service)
#
# WorkingDirectory가 /opt/petcare 인 이유: application.properties의
# spring.config.import=optional:file:.env 가 "현재 작업 디렉터리 기준 상대경로"로
# .env를 읽는다 (로컬 bootRun·mcp-server.sh와 동일 메커니즘). /opt/petcare/.env 필수.
#
# 설치: sudo systemctl daemon-reload && sudo systemctl enable --now petcare-backend

[Unit]
Description=Pet Care Spring Boot Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/petcare
ExecStart=/usr/bin/java -jar /opt/petcare/pet_backend.jar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
